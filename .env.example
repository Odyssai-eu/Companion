# Companion .env.example
#
# Copy to .env and fill in. The .env file is loaded by docker-compose
# at `docker compose up` time. For native `npm run dev` (no Docker),
# export the variables in your shell instead — tsx does not auto-load
# .env files.

# Port the app listens on (inside the container, or natively).
PORT=3000

# Database URL. Default matches the postgres service in docker-compose
# (`db:5432`). For `npm run dev` against a host-side Postgres, swap
# `db` for `localhost`.
DATABASE_URL=postgres://companion:companion@localhost:5432/companion

# Session JWT secret. Replace before exposing Companion beyond
# localhost. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=replace-me-with-a-real-secret-before-deploy

# Public sign-up. 0 = closed (default — operator seeds the first
# account, adds more manually). 1 = open self-serve sign-up.
ALLOW_SIGNUP=0

# Optional Karpathy memory compiler service (separate repo). Leave
# unset to skip — the memory wiki will not auto-compile from your
# conversation history, but everything else works.
# MEMORY_SERVICE_URL=http://host.docker.internal:8001

# LAN subnets to scan for Odysseus engines when the user clicks
# "Discover" in Settings → Infrastructure → Engine. The container sits
# on the Docker bridge, so it can't auto-detect the host's LAN.
# Comma-separated CIDRs. Common values: 192.168.1.0/24, 10.0.0.0/24.
ODYSSAI_SCAN_SUBNETS=192.168.1.0/24

NODE_ENV=development
